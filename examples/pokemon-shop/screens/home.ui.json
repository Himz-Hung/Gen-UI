{
  "screen": "Home",
  "root": "page",
  "elements": {
    "page":     { "type": "Container", "props": { "maxWidth": "xl" }, "children": ["bar", "body"] },
    "bar":      { "type": "TopBar", "props": { "title": { "i18n": "shop.name" }, "actions": [{ "icon": "cart", "label": { "i18n": "nav.cart", "params": { "count": { "path": "/cartCount" } } }, "action": "goCart" }] }, "on": { "actionPress": "goCart" } },
    "body":     { "type": "Stack", "props": { "gap": "5" }, "children": ["filters", "grid", "empty", "pager"] },
    "filters":  { "type": "Inline", "props": { "gap": "3", "wrap": true }, "children": ["search", "setFilter"] },
    "search":   { "type": "SearchBox", "props": { "value": { "path": "/query" }, "placeholder": { "i18n": "home.search" } }, "on": { "search": "search", "clear": "search" } },
    "setFilter":{ "type": "Select", "props": { "label": { "i18n": "home.set" }, "value": "", "options": [{ "value": "", "label": { "i18n": "home.allSets" } }], "placeholder": { "i18n": "home.allSets" } }, "on": { "change": "filterSet" } },
    "grid":     { "type": "Grid", "props": { "minItemWidth": 240, "gap": "4" }, "children": ["cardTile"] },
    "cardTile": { "type": "Card", "repeat": { "path": "/cards", "as": "card" }, "props": { "padding": "3", "pressable": true }, "on": { "press": "goCardDetail" }, "children": ["cardStack"] },
    "cardStack":{ "type": "Stack", "props": { "gap": "2" }, "children": ["img", "name", "meta", "priceRow"] },
    "img":      { "type": "Image", "props": { "src": { "path": "card/imageUrl" }, "alt": "", "ratio": "5:7", "fit": "contain" } },
    "name":     { "type": "Heading", "props": { "value": { "path": "card/name" }, "level": "3", "size": "sm" } },
    "meta":     { "type": "Inline", "props": { "gap": "2" }, "children": ["setName", "rarity", "condition"] },
    "setName":  { "type": "Text", "props": { "value": { "path": "card/set/name" }, "size": "sm", "color": "muted", "truncate": true } },
    "rarity":   { "type": "Badge", "props": { "label": { "path": "card/rarity" }, "tone": "primary" } },
    "condition":{ "type": "Badge", "props": { "label": { "path": "card/condition" }, "tone": "neutral" } },
    "priceRow": { "type": "Inline", "props": { "justify": "between" }, "children": ["price", "add"] },
    "price":    { "type": "Text", "props": { "value": { "path": "card/priceLabel" }, "weight": "bold" } },
    "add":      { "type": "Button", "props": { "label": { "i18n": "common.addToCart" }, "size": "sm", "icon": "plus" }, "on": { "press": "addToCart" } },
    "empty":    { "type": "EmptyState", "props": { "title": { "i18n": "home.empty.title" }, "description": { "i18n": "home.empty.description" }, "actionLabel": { "i18n": "home.empty.action" } }, "on": { "action": "search" } },
    "pager":    { "type": "Pagination", "props": { "page": { "path": "/page" }, "pageCount": { "path": "/pageCount" } }, "on": { "change": "changePage" } }
  }
}
