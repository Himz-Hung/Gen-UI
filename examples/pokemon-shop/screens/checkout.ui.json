{
  "screen": "Checkout",
  "root": "page",
  "elements": {
    "page":    { "type": "Container", "props": { "maxWidth": "md" }, "children": ["bar", "body"] },
    "bar":     { "type": "TopBar", "props": { "title": { "i18n": "checkout.title" }, "showBack": true }, "on": { "back": "goBack" } },
    "body":    { "type": "Stack", "props": { "gap": "5" }, "children": ["form", "divider", "summary", "place"] },
    "form":    { "type": "Stack", "props": { "gap": "3" }, "children": ["email", "address"] },
    "email":   { "type": "Input", "props": { "label": { "i18n": "checkout.email" }, "type": "email", "value": { "path": "/email" }, "error": { "path": "/emailError" }, "required": true }, "on": { "change": "changeEmail" } },
    "address": { "type": "Input", "props": { "label": { "i18n": "checkout.address" }, "value": { "path": "/address" }, "required": true }, "on": { "change": "changeAddress" } },
    "divider": { "type": "Divider" },
    "summary": { "type": "Inline", "props": { "justify": "between" }, "children": ["count", "subtotal"] },
    "count":   { "type": "Text", "props": { "value": { "i18n": "common.itemsMany", "params": { "count": { "path": "/cart/count" } } }, "color": "muted" } },
    "subtotal":{ "type": "Stat", "props": { "label": { "i18n": "common.subtotal" }, "value": { "path": "/cart/subtotalLabel" } } },
    "place":   { "type": "Button", "props": { "label": { "i18n": "checkout.placeOrder" }, "size": "lg", "fullWidth": true, "loading": { "path": "/submitting" } }, "on": { "press": "placeOrder" } }
  }
}
