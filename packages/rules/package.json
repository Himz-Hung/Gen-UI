{
  "name": "@himz-genui/rules",
  "version": "2.0.0",
  "description": "Shipped UI component contracts for @himz-genui/core (76 platform-neutral contracts: layout, typography, actions, inputs, forms, data display, media, feedback, navigation, overlays, charts).",
  "keywords": [
    "ui",
    "contracts",
    "design-system",
    "genui"
  ],
  "license": "MIT",
  "author": "Himz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himz-Hung/Gen-UI.git"
  },
  "homepage": "https://github.com/Himz-Hung/Gen-UI#readme",
  "bugs": "https://github.com/Himz-Hung/Gen-UI/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@himz-genui/core": "^2.0.0"
  }
}
